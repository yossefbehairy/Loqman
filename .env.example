# Copy this file to `.env` (root) and `backend/.env`, then adjust locally.
# NEVER commit real `.env` files -- they are gitignored.

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false

# --- AI runtime (local OpenCode server) -----------------------------------
# The desktop app expects an OpenCode server on the same machine.
RUNTIME_MODE=real
OPENCODE_BASE_URL=http://127.0.0.1:49100
# Must exist in the live free catalog; revalidated before every execution.
DEFAULT_MODEL_ID=deepseek-v4.1-flash-free

# --- Desktop mode (set automatically by Electron, do not set manually) ----
# AGENTOS_DATA_DIR=%APPDATA%\AgentOS
