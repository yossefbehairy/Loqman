# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/build/*
!frontend/build/icon.ico
frontend/release/
frontend/release-next/
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Electron / PyInstaller build artifacts
# Frozen backend sidecar (rebuild via pyinstaller/build-backend.ps1)
frontend/build-resources/agentos-backend.exe
backend/dist/
backend/build/
*.spec.bak
*.exe
# Keep the desktop icon (required by electron-builder: build/icon.ico)
!frontend/build/icon.ico

# Databases (local-only, never commit)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Env / secrets (never commit)
.env
.env.local
.env.*.local
backend/.env
backend/*.db*

# Internal agent orchestration logs
.agents/

# Large local spec binaries with non-ASCII names (kept locally, not in git)
*.pdf
*.docx

# OS / IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.log
logs/
