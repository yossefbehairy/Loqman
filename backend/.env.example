# Copy this file to `.env` (root) and `backend/.env`, then adjust locally.
# NEVER commit real `.env` files — they are gitignored.

# ─── Server ───
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ─── Default AI runtime ───
# real (default) or mock=deterministic demo/test. The default engine/model is chosen in Settings;
# the old claude/codex/agy modes were removed.
RUNTIME_MODE=real
# Standalone development only: set AGENTOS_INSECURE_DEV=1 to run without a local token.
# Engine setup and status are exposed under /api/engines; billing and account model access may be unknown.
OPENCODE_BASE_URL=http://127.0.0.1:49100
DEFAULT_MODEL_ID=muse-spark-1.3-contributor-free

# ─── Desktop mode (set automatically by Electron, do not set manually) ───
# AGENTOS_DATA_DIR=%APPDATA%\AgentOS
